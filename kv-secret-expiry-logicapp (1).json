{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "la-kv-secret-expiry-monitor",
      "metadata": { "description": "Name of the Logic App" }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "targetSubscriptionId": {
      "type": "string",
      "defaultValue": "[subscription().subscriptionId]",
      "metadata": { "description": "Subscription whose Key Vaults will be scanned" }
    },
    "expiryThresholdDays": {
      "type": "int",
      "defaultValue": 15,
      "metadata": { "description": "Alert if secret expires within this many days" }
    },
    "recipientEmail": {
      "type": "string",
      "defaultValue": "raviverma@microsoft.com"
    },
    "office365ConnectionName": {
      "type": "string",
      "defaultValue": "office365"
    },
    "scheduleHour": {
      "type": "string",
      "defaultValue": "9",
      "metadata": { "description": "Hour (0-23) in India Standard Time to run daily" }
    }
  },
  "variables": {
    "office365ConnectionId": "[resourceId('Microsoft.Web/connections', parameters('office365ConnectionName'))]",
    "office365ApiId": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/office365')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[parameters('office365ConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "Office 365 Outlook",
        "api": { "id": "[variables('office365ApiId')]" }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', parameters('office365ConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": { "defaultValue": {}, "type": "Object" },
            "expiryThresholdDays": {
              "defaultValue": "[parameters('expiryThresholdDays')]",
              "type": "Int"
            },
            "recipientEmail": {
              "defaultValue": "[parameters('recipientEmail')]",
              "type": "String"
            },
            "targetSubscriptionId": {
              "defaultValue": "[parameters('targetSubscriptionId')]",
              "type": "String"
            }
          },
          "triggers": {
            "Daily_at_9AM_IST": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "schedule": {
                  "hours": [ "[parameters('scheduleHour')]" ],
                  "minutes": [ 0 ]
                },
                "timeZone": "India Standard Time"
              }
            }
          },
          "actions": {
            "Initialize_Variables": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  { "name": "ExpiringSecrets", "type": "Array", "value": [] },
                  { "name": "VaultErrors", "type": "Array", "value": [] }
                ]
              },
              "runAfter": {}
            },
            "Compute_NowUnix": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "NowUnix",
                    "type": "Integer",
                    "value": "@div(sub(ticks(utcNow()), ticks('1970-01-01T00:00:00Z')), 10000000)"
                  }
                ]
              },
              "runAfter": { "Initialize_Variables": [ "Succeeded" ] }
            },
            "Compute_ThresholdUnix": {
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "ThresholdUnix",
                    "type": "Integer",
                    "value": "@add(variables('NowUnix'), mul(parameters('expiryThresholdDays'), 86400))"
                  }
                ]
              },
              "runAfter": { "Compute_NowUnix": [ "Succeeded" ] }
            },
            "List_KeyVaults": {
              "type": "Http",
              "inputs": {
                "uri": "@{concat('https://management.azure.com/subscriptions/', parameters('targetSubscriptionId'), '/providers/Microsoft.KeyVault/vaults')}",
                "method": "GET",
                "queries": { "api-version": "2023-02-01" },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://management.azure.com/"
                }
              },
              "runAfter": { "Compute_ThresholdUnix": [ "Succeeded" ] }
            },
            "For_each_vault": {
              "type": "Foreach",
              "foreach": "@body('List_KeyVaults')?['value']",
              "actions": {
                "Scope_Vault": {
                  "type": "Scope",
                  "actions": {
                    "List_Secrets": {
                      "type": "Http",
                      "inputs": {
                        "uri": "@{concat('https://management.azure.com', items('For_each_vault')?['id'], '/secrets')}",
                        "method": "GET",
                        "queries": { "api-version": "2023-02-01" },
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "audience": "https://management.azure.com/"
                        }
                      }
                    },
                    "For_each_secret": {
                      "type": "Foreach",
                      "foreach": "@body('List_Secrets')?['value']",
                      "actions": {
                        "Check_expiry": {
                          "type": "If",
                          "expression": {
                            "and": [
                              { "not": { "equals": [ "@items('For_each_secret')?['properties']?['attributes']?['exp']", null ] } },
                              { "lessOrEquals":    [ "@items('For_each_secret')?['properties']?['attributes']?['exp']", "@variables('ThresholdUnix')" ] },
                              { "greaterOrEquals": [ "@items('For_each_secret')?['properties']?['attributes']?['exp']", "@variables('NowUnix')" ] }
                            ]
                          },
                          "actions": {
                            "Append_to_ExpiringSecrets": {
                              "type": "AppendToArrayVariable",
                              "inputs": {
                                "name": "ExpiringSecrets",
                                "value": {
                                  "vault": "@{items('For_each_vault')?['name']}",
                                  "name": "@{items('For_each_secret')?['name']}",
                                  "expiresOn": "@{formatDateTime(addSeconds('1970-01-01T00:00:00Z', items('For_each_secret')?['properties']?['attributes']?['exp']), 'yyyy-MM-dd HH:mm')} UTC",
                                  "daysRemaining": "@{div(sub(items('For_each_secret')?['properties']?['attributes']?['exp'], variables('NowUnix')), 86400)}"
                                }
                              }
                            }
                          },
                          "else": { "actions": {} }
                        }
                      },
                      "runAfter": { "List_Secrets": [ "Succeeded" ] }
                    }
                  }
                },
                "On_vault_failure": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "VaultErrors",
                    "value": {
                      "vault": "@{items('For_each_vault')?['name']}",
                      "reason": "Access denied or unreachable — verify the Logic App identity has Reader role on the subscription."
                    }
                  },
                  "runAfter": { "Scope_Vault": [ "Failed", "Skipped", "TimedOut" ] }
                }
              },
              "runAfter": { "List_KeyVaults": [ "Succeeded" ] },
              "runtimeConfiguration": {
                "concurrency": { "repetitions": 8 }
              }
            },
            "Build_SecretCsvRows": {
              "type": "Select",
              "inputs": {
                "from": "@variables('ExpiringSecrets')",
                "select": "@concat(item()?['vault'], ',', item()?['name'], ',', item()?['expiresOn'], ',', item()?['daysRemaining'])"
              },
              "runAfter": { "For_each_vault": [ "Succeeded" ] }
            },
            "Compose_CsvContent": {
              "type": "Compose",
              "inputs": "@concat('Vault,Secret Name,Expires On (UTC),Days Remaining', decodeUriComponent('%0A'), join(body('Build_SecretCsvRows'), decodeUriComponent('%0A')))",
              "runAfter": { "Build_SecretCsvRows": [ "Succeeded" ] }
            },
            "Send_email_if_any": {
              "type": "If",
              "expression": {
                "or": [
                  { "greater": [ "@length(variables('ExpiringSecrets'))", 0 ] },
                  { "greater": [ "@length(variables('VaultErrors'))", 0 ] }
                ]
              },
              "actions": {
                "Send_email": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": { "name": "@parameters('$connections')['office365']['connectionId']" }
                    },
                    "method": "post",
                    "path": "/v2/Mail",
                    "body": {
                      "To": "@{parameters('recipientEmail')}",
                      "Subject": "@{concat('[KV Alert] ', length(variables('ExpiringSecrets')), ' secret(s) expiring in next ', parameters('expiryThresholdDays'), ' days')}",
                      "Body": "<p>Hi Ravi,</p><p>Attached is the Key Vault secret expiry report.</p><p><b>Subscription:</b> @{parameters('targetSubscriptionId')}<br/><b>Vaults scanned:</b> @{length(body('List_KeyVaults')?['value'])}<br/><b>Threshold:</b> @{parameters('expiryThresholdDays')} days<br/><b>Expiring secrets:</b> @{length(variables('ExpiringSecrets'))}<br/><b>Run date:</b> @{formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm')} UTC</p>@{if(greater(length(variables('VaultErrors')), 0), concat('<p style=\"color:#a4262c;\"><b>Vaults skipped (no access / unreachable):</b> ', length(variables('VaultErrors')), '</p>'), '')}<p>Please rotate the listed secrets before expiry.</p>",
                      "Importance": "High",
                      "Attachments": [
                        {
                          "Name": "@{concat('kv-expiring-secrets-', formatDateTime(utcNow(), 'yyyy-MM-dd'), '.csv')}",
                          "ContentBytes": "@{base64(outputs('Compose_CsvContent'))}",
                          "ContentType": "text/csv"
                        }
                      ]
                    }
                  }
                }
              },
              "else": { "actions": {} },
              "runAfter": { "Compose_CsvContent": [ "Succeeded" ] }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "office365": {
                "connectionId": "[variables('office365ConnectionId')]",
                "connectionName": "[parameters('office365ConnectionName')]",
                "id": "[variables('office365ApiId')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01', 'Full').identity.principalId]"
    },
    "logicAppName": {
      "type": "string",
      "value": "[parameters('logicAppName')]"
    },
    "office365ConnectionName": {
      "type": "string",
      "value": "[parameters('office365ConnectionName')]"
    }
  }
}
