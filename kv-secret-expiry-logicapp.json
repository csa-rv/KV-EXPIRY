{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "la-kv-secret-expiry-monitor",
      "metadata": { "description": "Name of the Logic App" }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "targetSubscriptionId": {
      "type": "string",
      "defaultValue": "[subscription().subscriptionId]",
      "metadata": { "description": "Subscription whose Key Vaults will be scanned" }
    },
    "expiryThresholdDays": {
      "type": "int",
      "defaultValue": 15,
      "metadata": { "description": "Alert if secret expires within this many days" }
    },
    "recipientEmail": {
      "type": "string",
      "defaultValue": "raviverma@microsoft.com"
    },
    "office365ConnectionName": {
      "type": "string",
      "defaultValue": "office365"
    }
  },
  "variables": {
    "office365ConnectionId": "[resourceId('Microsoft.Web/connections', parameters('office365ConnectionName'))]",
    "office365ApiId": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/office365')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[parameters('office365ConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "Office 365 Outlook",
        "api": { "id": "[variables('office365ApiId')]" }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', parameters('office365ConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": { "defaultValue": {}, "type": "Object" },
            "expiryThresholdDays": {
              "defaultValue": "[parameters('expiryThresholdDays')]",
              "type": "Int"
            },
            "recipientEmail": {
              "defaultValue": "[parameters('recipientEmail')]",
              "type": "String"
            },
            "targetSubscriptionId": {
              "defaultValue": "[parameters('targetSubscriptionId')]",
              "type": "String"
            }
          },
          "triggers": {
            "Daily_at_9AM_IST": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "schedule": { "hours": ["9"], "minutes": [0] },
                "timeZone": "India Standard Time"
              }
            }
          },
          "actions": {
            "Initialize_ExpiringSecrets": {
              "type": "InitializeVariable",
              "runAfter": {},
              "inputs": {
                "variables": [
                  { "name": "ExpiringSecrets", "type": "Array", "value": [] }
                ]
              }
            },
            "Initialize_VaultErrors": {
              "type": "InitializeVariable",
              "runAfter": { "Initialize_ExpiringSecrets": ["Succeeded"] },
              "inputs": {
                "variables": [
                  { "name": "VaultErrors", "type": "Array", "value": [] }
                ]
              }
            },
            "List_KeyVaults": {
              "type": "Http",
              "runAfter": { "Initialize_VaultErrors": ["Succeeded"] },
              "inputs": {
                "method": "GET",
                "uri": "@{concat('https://management.azure.com/subscriptions/', parameters('targetSubscriptionId'), '/resources')}",
                "queries": {
                  "api-version": "2021-04-01",
                  "$filter": "resourceType eq 'Microsoft.KeyVault/vaults'"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://management.azure.com/"
                }
              }
            },
            "For_each_vault": {
              "type": "Foreach",
              "foreach": "@body('List_KeyVaults')?['value']",
              "runAfter": { "List_KeyVaults": ["Succeeded"] },
              "runtimeConfiguration": {
                "concurrency": { "repetitions": 8 }
              },
              "actions": {
                "Scope_Vault": {
                  "type": "Scope",
                  "actions": {
                    "List_Secrets": {
                      "type": "Http",
                      "inputs": {
                        "method": "GET",
                        "uri": "@{concat('https://', items('For_each_vault')?['name'], '.vault.azure.net/secrets')}",
                        "queries": {
                          "api-version": "7.4",
                          "maxresults": "25"
                        },
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "audience": "https://vault.azure.net"
                        }
                      }
                    },
                    "For_each_secret": {
                      "type": "Foreach",
                      "foreach": "@body('List_Secrets')?['value']",
                      "runAfter": { "List_Secrets": ["Succeeded"] },
                      "actions": {
                        "Check_expiry": {
                          "type": "If",
                          "expression": {
                            "and": [
                              { "not": { "equals": ["@items('For_each_secret')?['attributes']?['exp']", null] } },
                              {
                                "lessOrEquals": [
                                  "@items('For_each_secret')?['attributes']?['exp']",
                                  "@addToTime(utcNow(), parameters('expiryThresholdDays'), 'Day', 'U')"
                                ]
                              },
                              {
                                "greaterOrEquals": [
                                  "@items('For_each_secret')?['attributes']?['exp']",
                                  "@div(sub(ticks(utcNow()), ticks('1970-01-01T00:00:00Z')), 10000000)"
                                ]
                              }
                            ]
                          },
                          "actions": {
                            "Append_to_ExpiringSecrets": {
                              "type": "AppendToArrayVariable",
                              "inputs": {
                                "name": "ExpiringSecrets",
                                "value": {
                                  "vault": "@{items('For_each_vault')?['name']}",
                                  "name": "@{last(split(items('For_each_secret')?['id'], '/'))}",
                                  "id": "@{items('For_each_secret')?['id']}",
                                  "expiresOn": "@{formatDateTime(addSeconds('1970-01-01T00:00:00Z', items('For_each_secret')?['attributes']?['exp']), 'yyyy-MM-dd HH:mm UTC')}",
                                  "daysRemaining": "@{div(sub(items('For_each_secret')?['attributes']?['exp'], div(sub(ticks(utcNow()), ticks('1970-01-01T00:00:00Z')), 10000000)), 86400)}"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "runAfter": {}
                },
                "On_vault_failure": {
                  "type": "AppendToArrayVariable",
                  "runAfter": { "Scope_Vault": ["Failed", "Skipped", "TimedOut"] },
                  "inputs": {
                    "name": "VaultErrors",
                    "value": {
                      "vault": "@{items('For_each_vault')?['name']}",
                      "reason": "Access denied or unreachable — verify the Logic App identity has 'Key Vault Secrets User' or list-secret permission, and the vault firewall allows trusted Azure services."
                    }
                  }
                }
              }
            },
            "Send_email_if_any": {
              "type": "If",
              "runAfter": { "For_each_vault": ["Succeeded"] },
              "expression": {
                "or": [
                  { "greater": ["@length(variables('ExpiringSecrets'))", 0] },
                  { "greater": ["@length(variables('VaultErrors'))", 0] }
                ]
              },
              "actions": {
                "Send_email": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": { "name": "@parameters('$connections')['office365']['connectionId']" }
                    },
                    "method": "post",
                    "path": "/v2/Mail",
                    "body": {
                      "To": "@{parameters('recipientEmail')}",
                      "Subject": "@{concat('[KV Alert] ', length(variables('ExpiringSecrets')), ' secret(s) across subscription expiring in next ', parameters('expiryThresholdDays'), ' days')}",
                      "Body": "<h2>Key Vault Secret Expiry Report</h2><p><b>Subscription:</b> @{parameters('targetSubscriptionId')}<br/><b>Vaults scanned:</b> @{length(body('List_KeyVaults')?['value'])}<br/><b>Threshold:</b> @{parameters('expiryThresholdDays')} days<br/><b>Run date:</b> @{formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm UTC')}</p><h3>Expiring Secrets (@{length(variables('ExpiringSecrets'))})</h3>@{if(greater(length(variables('ExpiringSecrets')), 0), concat('<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse;\"><tr style=\"background:#0078d4;color:#fff;\"><th>Vault</th><th>Secret Name</th><th>Expires On (UTC)</th><th>Days Remaining</th></tr>', join(select(variables('ExpiringSecrets'), concat('<tr><td>', item()?['vault'], '</td><td>', item()?['name'], '</td><td>', item()?['expiresOn'], '</td><td>', item()?['daysRemaining'], '</td></tr>')), ''), '</table>'), '<p><i>No secrets expiring in window.</i></p>')}<h3>Vaults Skipped (@{length(variables('VaultErrors'))})</h3>@{if(greater(length(variables('VaultErrors')), 0), concat('<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse;\"><tr style=\"background:#a4262c;color:#fff;\"><th>Vault</th><th>Reason</th></tr>', join(select(variables('VaultErrors'), concat('<tr><td>', item()?['vault'], '</td><td>', item()?['reason'], '</td></tr>')), ''), '</table>'), '<p><i>All vaults scanned successfully.</i></p>')}<p style=\"margin-top:16px;\">Please rotate the listed secrets before expiry.</p>",
                      "Importance": "High"
                    }
                  }
                }
              },
              "else": { "actions": {} }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "office365": {
                "connectionId": "[variables('office365ConnectionId')]",
                "connectionName": "[parameters('office365ConnectionName')]",
                "id": "[variables('office365ApiId')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01', 'Full').identity.principalId]"
    }
  }
}
