{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "kv-expiry-alert",
      "version": "1.0.0.0"
    }
  },
  "parameters": {
    "keyVaultName": {
      "type": "string",
      "metadata": {
        "description": "Name of the existing Key Vault to monitor."
      }
    },
    "keyVaultResourceGroup": {
      "type": "string",
      "defaultValue": "[resourceGroup().name]",
      "metadata": {
        "description": "Resource group containing the Key Vault (defaults to this RG)."
      }
    },
    "notificationEmail": {
      "type": "string",
      "metadata": {
        "description": "Email address (or distribution list) that receives expiry alerts."
      }
    },
    "expiryThresholdDays": {
      "type": "int",
      "defaultValue": 15,
      "metadata": {
        "description": "Send an alert when a secret expires in this many days or fewer."
      }
    },
    "logicAppName": {
      "type": "string",
      "defaultValue": "[concat('la-kv-expiry-', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Name of the Logic App that runs the daily check."
      }
    },
    "scheduleHour": {
      "type": "int",
      "defaultValue": 9,
      "metadata": {
        "description": "Hour of day (0-23, IST) to run the check."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    }
  },
  "variables": {
    "o365ConnectionName": "[concat(parameters('logicAppName'), '-office365')]",
    "o365ApiId": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/office365')]",
    "kvReaderRoleId": "21090545-7ca7-4776-b22c-e363652d74d2"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('o365ConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "Office 365 Outlook",
        "api": {
          "id": "[variables('o365ApiId')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('o365ConnectionName'))]"
      ],
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "keyVaultName": {
              "type": "String",
              "defaultValue": ""
            },
            "thresholdDays": {
              "type": "Int",
              "defaultValue": 15
            },
            "notificationEmail": {
              "type": "String",
              "defaultValue": ""
            }
          },
          "triggers": {
            "Daily_Check": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "schedule": {
                  "hours": [
                    "@{parameters('scheduleHour')}"
                  ],
                  "minutes": [
                    0
                  ]
                },
                "timeZone": "India Standard Time"
              }
            }
          },
          "actions": {
            "List_Secrets": {
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "@{concat('https://', parameters('keyVaultName'), '.vault.azure.net/secrets?api-version=7.4&maxresults=25')}",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://vault.azure.net"
                }
              },
              "runAfter": {}
            },
            "Parse_Secret_List": {
              "type": "ParseJson",
              "inputs": {
                "content": "@body('List_Secrets')",
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "attributes": {
                            "type": "object",
                            "properties": {
                              "enabled": { "type": "boolean" },
                              "exp": { "type": "integer" }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "runAfter": {
                "List_Secrets": [ "Succeeded" ]
              }
            },
            "Filter_Expiring_Secrets": {
              "type": "Query",
              "inputs": {
                "from": "@body('Parse_Secret_List')?['value']",
                "where": "@and(not(equals(item()?['attributes']?['exp'], null)), lessOrEquals(div(sub(mul(item()?['attributes']?['exp'], 1000), ticks(utcNow())), 864000000000), parameters('thresholdDays')), greaterOrEquals(item()?['attributes']?['exp'], div(sub(ticks(utcNow()), ticks('1970-01-01T00:00:00Z')), 10000000)))"
              },
              "runAfter": {
                "Parse_Secret_List": [ "Succeeded" ]
              }
            },
            "If_Any_Expiring": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@length(body('Filter_Expiring_Secrets'))",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "Build_Rows": {
                  "type": "Select",
                  "inputs": {
                    "from": "@body('Filter_Expiring_Secrets')",
                    "select": {
                      "Secret": "@last(split(item()?['id'], '/'))",
                      "ExpiresUTC": "@addSeconds('1970-01-01T00:00:00Z', item()?['attributes']?['exp'])",
                      "DaysLeft": "@div(sub(mul(item()?['attributes']?['exp'], 1000), ticks(utcNow())), 864000000000)",
                      "Enabled": "@item()?['attributes']?['enabled']"
                    }
                  },
                  "runAfter": {}
                },
                "Create_HTML_Table": {
                  "type": "Table",
                  "inputs": {
                    "from": "@body('Build_Rows')",
                    "format": "HTML"
                  },
                  "runAfter": {
                    "Build_Rows": [ "Succeeded" ]
                  }
                },
                "Send_Email": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['office365']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/v2/Mail",
                    "body": {
                      "To": "@parameters('notificationEmail')",
                      "Subject": "@{concat('[Action Required] Key Vault secrets expiring in ', parameters('thresholdDays'), ' days or less - ', parameters('keyVaultName'))}",
                      "Body": "<p>The following secrets in <b>@{parameters('keyVaultName')}</b> are expiring soon. Please rotate them before expiry.</p>@{body('Create_HTML_Table')}<p style='color:#888;font-size:11px;'>Sent automatically by the Key Vault Expiry Monitor Logic App.</p>",
                      "Importance": "High"
                    }
                  },
                  "runAfter": {
                    "Create_HTML_Table": [ "Succeeded" ]
                  }
                }
              },
              "runAfter": {
                "Filter_Expiring_Secrets": [ "Succeeded" ]
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "office365": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('o365ConnectionName'))]",
                "connectionName": "[variables('o365ConnectionName')]",
                "id": "[variables('o365ApiId')]"
              }
            }
          },
          "keyVaultName": {
            "value": "[parameters('keyVaultName')]"
          },
          "thresholdDays": {
            "value": "[parameters('expiryThresholdDays')]"
          },
          "notificationEmail": {
            "value": "[parameters('notificationEmail')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[concat('grant-kv-reader-', parameters('logicAppName'))]",
      "resourceGroup": "[parameters('keyVaultResourceGroup')]",
      "dependsOn": [
        "[resourceId('Microsoft.Logic/workflows', parameters('logicAppName'))]"
      ],
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": { "scope": "inner" },
        "parameters": {
          "keyVaultName": { "value": "[parameters('keyVaultName')]" },
          "principalId": { "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01', 'Full').identity.principalId]" },
          "kvReaderRoleId": { "value": "[variables('kvReaderRoleId')]" }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "keyVaultName": { "type": "string" },
            "principalId": { "type": "string" },
            "kvReaderRoleId": { "type": "string" }
          },
          "resources": [
            {
              "type": "Microsoft.KeyVault/vaults/providers/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[concat(parameters('keyVaultName'), '/Microsoft.Authorization/', guid(parameters('keyVaultName'), parameters('principalId'), parameters('kvReaderRoleId')))]",
              "properties": {
                "roleDefinitionId": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Authorization/roleDefinitions/', parameters('kvReaderRoleId'))]",
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal"
              }
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "logicAppName": {
      "type": "string",
      "value": "[parameters('logicAppName')]"
    },
    "logicAppPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01', 'Full').identity.principalId]"
    },
    "office365ConnectionName": {
      "type": "string",
      "value": "[variables('o365ConnectionName')]"
    },
    "postDeploySteps": {
      "type": "string",
      "value": "Open the Office 365 connection in the portal and click 'Authorize' to sign in with the mailbox that will send alerts."
    }
  }
}
